<% layout("/layout/boilerplate")%>
<%=success%>
<body>
    <style>
       @media (max-width: 768px) {
  .navbar-collapse {
    position: absolute;
    top: 60px;          /* below navbar */
    right: 10px;        /* stick to right */
    width: 200px;       /* dropdown width */
    background: white;  /* white panel */
    padding: 10px;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    z-index: 1000;
  }

  .navbar-nav {
    text-align: right;
  }

  .navbar-nav .nav-link {
    padding: 8px 10px;
  }
}
    </style>
    <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mb-2">
        <%for (listing of allListings){%>
             <a href="/listings/<%=listing.id%>" class="listingLink">
                <div class="card col" >
                     <img src="<%= listing.image.url%>" class="card-img-top listing-card" alt="listing image" style="height:20rem">
                     <div class="card text-bg-dark">
                         <div class="card-img-overlay">
                         </div>
                     </div>
                     <div class="card-body">
                    
                         <p class="card-text"><span class="listing-title"><%= listing.title %></span>
                             <br>
                             &#8377;<%=listing.price.toLocaleString("en-IN")%>/night</p>
                    
                     </div>
                 </div>
             </a>
         <% }%>
            
    </div>



</body>
