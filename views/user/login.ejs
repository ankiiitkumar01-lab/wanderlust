<% layout("/layout/boilerplate")%>
<style>footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: white;
    border-top: 1px solid #ddd;
    z-index: 1000;
}

.f-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
}</style>
<div class="row mt-3">
    <h1 class="col-6 offset-3">loggin on waderlust</h1>
    <div class="col-6 offset-3">
        <form action="/login" method="POST" class="needs-valildation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input name="username" 
                           id="username" 
                           type="text" 
                           class="form-control"
                           required 
                           /> 
            <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input name="password" 
                           id="password" 
                           type="password" 
                           class="form-control"
                           required 
                           />
                           
                </div>
                <button class="btn btn-success">login</button>
        </form>
    </div>
</div>


